.git/

# secrets / local config
.env
.env.*
!.env.example
# backend/.env is the exception — deliberately baked into the image (see
# the COPY line in Dockerfile) instead of injected/mounted at runtime.
# Image is self-contained, but now contains real secrets in its layers —
# only acceptable where registry access is itself already internal/
# controlled (see deploy/README.md).
!backend/.env

# local dev artifacts
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
backend/.venv/
backend/data/
*.db
*.sqlite3
node_modules/
frontend/dist/
admin-frontend/dist/
.vite/

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
