.git/

# secrets / local config
.env
.env.*
!.env.example
# backend/.env and backend/site_registry.seed.json are the exceptions —
# deliberately baked into the image (see the COPY lines in Dockerfile)
# instead of injected/mounted at runtime. Same tradeoff both times: image
# is self-contained and comes up pre-seeded, but now contains real
# secrets/site data in its layers — only acceptable where registry access
# is itself already internal/controlled (see deploy/README.md).
!backend/.env
!backend/site_registry.seed.json

# local dev artifacts
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
backend/.venv/
backend/data/
*.db
*.sqlite3
node_modules/
frontend/dist/
admin-frontend/dist/
.vite/

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
