GRAFANA_BASE_URL=http://<internal-grafana-host>:3000
GRAFANA_POSTGRES_DATASOURCE_UID=<postgres-datasource-uid>
GRAFANA_PROMETHEUS_DATASOURCE_UID=<prometheus-datasource-uid>
LOCAL_CLUSTER_ID=<local-cluster-id>

CACHE_TTL_SECONDS=90

PG_HOST=<dedicated-postgres-host>
PG_PORT=5432
PG_USER=<pg-user>
PG_PASSWORD=<pg-password>
PG_DATABASE=<pg-database>
PG_SCHEMA=dashboard

PUBLIC_API_PORT=8000
ADMIN_API_PORT=8001
